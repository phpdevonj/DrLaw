{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3|^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "google/cloud-firestore": "^1.54",
        "guzzlehttp/guzzle": "^7.8",
        "kreait/laravel-firebase": "^7.1",
        "laravel-notification-channels/onesignal": "^2.8",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "lavary/laravel-menu": "^1.8",
        "maatwebsite/excel": "^4.0",
        "matanyadaev/laravel-eloquent-spatial": "^4.7",
        "php-mqtt/laravel-client": "^1.0",
        "prabowosd/laravel-collective-html": "^1.1",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-permission": "^7.3",
        "spatie/laravel-sluggable": "^3.8",
        "yajra/laravel-datatables": "dev-master as 11.0",
        "yajra/laravel-datatables-oracle": "dev-master as 11.0",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/sail": "^1.39",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "ext-grpc": "1.50.0",
            "ext-protobuf": "4.31.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
